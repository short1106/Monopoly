# Kopieren nach .env und anpassen. Die .env wird nie committet.

# Pflicht für Probeklausuren
ANTHROPIC_API_KEY=

# Modell und Aufwand (effort: low, medium, high, xhigh, max)
APRIL_MODEL=claude-opus-5-5
APRIL_EFFORT=medium
APRIL_MAX_TOKENS=16000
# Serverseitiger Fallback auf ein anderes Modell, falls eine Anfrage abgelehnt wird
APRIL_USE_FALLBACKS=true
# Jede Woche automatisch pro Person eine Probeklausur erzeugen
APRIL_AUTO_GENERATE=true

# Bestehensgrenze in Prozent
APRIL_PASS_THRESHOLD=50

# Feste Treffen jeden Montag und Dienstag
APRIL_MEETING_TIME=16:00
APRIL_MEETING_DURATION_MIN=90
APRIL_CHECKIN_EARLY_MIN=15
APRIL_CHECKIN_GRACE_MIN=5

APRIL_TIMEZONE=Europe/Berlin
APRIL_DB_PATH=data/april.db
APRIL_SESSION_DAYS=14
# Auf true setzen, sobald die App über HTTPS läuft
APRIL_COOKIE_SECURE=false
